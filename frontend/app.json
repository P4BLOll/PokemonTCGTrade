{
  "expo": {
    "name": "AERO-OS // Amber Terminal",
    "slug": "aero-os-frontend",
    "version": "1.0.0",
    "platforms": ["web"],
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
